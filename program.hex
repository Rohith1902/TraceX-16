6	ADDI R5, R0, 9	                        should be skipped
7	ADDI R5, R0, 20	                        R5 = 20
8	JAL +2	                                jumps to addr 10, R7 = 9
9	ADDI R6, R0, 7	                        should be skipped
10	HALT	                                stop*/