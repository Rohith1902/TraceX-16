/*Addr	Instruction	What it does
0	ADDI R1, R0, 5	                        R1 = 5
1	ADDI R2, R0, 3	                        R2 = 3
2	ADD R3, R1, R2	                        R3 = 8
3	STORE  [R0+10] = R3	                    mem[10] = 8
4	LOAD R4,[R0+10]	                        R4 = 8
